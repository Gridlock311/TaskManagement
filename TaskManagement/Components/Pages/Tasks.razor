@page "/tasks"
@rendermode InteractiveServer

@using TaskManagement.Models
@using TaskManagement.Services

@inject TaskService TaskService
@inject EmployeeService EmployeeService

<div class="d-flex align-items-center gap-3 mb-4">
    <h1 class="mb-0">Tasks</h1>

    <button class="btn btn-success"
            @onclick="OpenCreateModal">
        + Add Task
    </button>
</div>


<!-- ======================== -->
<!-- FILTER -->
<!-- ======================== -->
<div class="card p-3 mb-4">
    <h4>Task Filter</h4>

    <form @onsubmit="ApplyFilters"
          @onsubmit:preventDefault>

        <div class="row">

            <div class="col-md-3 mb-2">
                <label>Employee</label>

                <select class="form-select"
                        @bind="filterEmployeeId">

                    <option value="">All Employees</option>

                    @if (employees != null)
                    {
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">
                                @employee.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-3 mb-2">
                <label>Status</label>

                <select class="form-select"
                        @bind="filterStatus">

                    <option value="">All Status</option>
                    <option value="1">New</option>
                    <option value="2">In Progress</option>
                    <option value="3">Completed</option>
                    <option value="4">Cancelled</option>

                </select>
            </div>

            <div class="col-md-3 mb-2">
                <label>Priority</label>

                <select class="form-select"
                        @bind="filterPriority">

                    <option value="">All Priority</option>
                    <option value="1">Low</option>
                    <option value="2">Normal</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>

                </select>
            </div>

            <div class="col-md-3 mb-2">
                <label>Search</label>

                <input class="form-control"
                       placeholder="Task title..."
                       @bind="searchText" />
            </div>

        </div>

        <button type="submit"
                class="btn btn-primary me-2">
            Search
        </button>

        <button type="button"
                class="btn btn-secondary"
                @onclick="ClearFilters">
            Clear
        </button>

    </form>
</div>


<!-- ======================== -->
<!-- CREATE TASK MODAL -->
<!-- ======================== -->
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal d-block"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Create Task</h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseCreateModal">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert alert-danger">
                            @message
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Title</label>

                        <input class="form-control"
                               @bind="newTask.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>

                        <textarea class="form-control"
                                  rows="3"
                                  @bind="newTask.Description">
                        </textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Employee</label>

                        <select class="form-select"
                                @bind="newTask.EmployeeId">

                            <option value="0">-- Employee сонго --</option>

                            @if (employees != null)
                            {
                                @foreach (var employee in employees.Where(x => x.IsActive))
                                {
                                    <option value="@employee.Id">
                                        @employee.Name - @employee.Department
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Priority</label>

                        <select class="form-select"
                                @bind="newTask.Priority">

                            <option value="@TaskPriority.Low">Low</option>
                            <option value="@TaskPriority.Normal">Normal</option>
                            <option value="@TaskPriority.High">High</option>
                            <option value="@TaskPriority.Critical">Critical</option>

                        </select>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>

                            <input type="date"
                                   class="form-control"
                                   @bind="newTask.StartDate" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Due Date</label>

                            <input type="date"
                                   class="form-control"
                                   @bind="newTask.DueDate" />
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseCreateModal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="CreateTask">
                        Save
                    </button>

                </div>

            </div>

        </div>

    </div>
}


<!-- ======================== -->
<!-- EDIT TASK MODAL -->
<!-- ======================== -->
@if (editTask != null)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal d-block"
         tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Edit Task #@editTask.Id
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CancelEdit">
                    </button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrWhiteSpace(editMessage))
                    {
                        <div class="alert alert-danger">
                            @editMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Title</label>

                        <input class="form-control"
                               @bind="editTask.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>

                        <textarea class="form-control"
                                  rows="3"
                                  @bind="editTask.Description">
                        </textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Employee</label>

                        <select class="form-select"
                                @bind="editTask.EmployeeId">

                            @if (employees != null)
                            {
                                @foreach (var employee in employees.Where(
                                    x => x.IsActive ||
                                         x.Id == editTask.EmployeeId))
                                {
                                    <option value="@employee.Id">
                                        @employee.Name - @employee.Department
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Priority</label>

                        <select class="form-select"
                                @bind="editTask.Priority">

                            <option value="@TaskPriority.Low">Low</option>
                            <option value="@TaskPriority.Normal">Normal</option>
                            <option value="@TaskPriority.High">High</option>
                            <option value="@TaskPriority.Critical">Critical</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>

                        <select class="form-select"
                                @bind="editTask.Status">

                            <option value="@TaskManagement.Models.TaskStatus.New">New</option>
                            <option value="@TaskManagement.Models.TaskStatus.InProgress">In Progress</option>
                            <option value="@TaskManagement.Models.TaskStatus.Completed">Completed</option>
                            <option value="@TaskManagement.Models.TaskStatus.Cancelled">Cancelled</option>

                        </select>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>

                            <input type="date"
                                   class="form-control"
                                   @bind="editTask.StartDate" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Due Date</label>

                            <input type="date"
                                   class="form-control"
                                   @bind="editTask.DueDate" />
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="SaveTask">
                        Save
                    </button>

                </div>

            </div>

        </div>

    </div>
}


<!-- ======================== -->
<!-- DELETE CONFIRM MODAL -->
<!-- ======================== -->
@if (showDeleteModal)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal d-block"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Delete Task</h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseDeleteModal">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-2">
                        Are you sure you want to delete this task?
                    </p>

                    @if (!string.IsNullOrWhiteSpace(deleteTaskTitle))
                    {
                        <strong>@deleteTaskTitle</strong>
                    }
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDeleteModal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDeleteTask">
                        Delete
                    </button>

                </div>

            </div>

        </div>

    </div>
}


@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-danger">
        @statusMessage
    </div>
}


<!-- ======================== -->
<!-- TASK LIST -->
<!-- ======================== -->
@if (tasks == null)
{
    <p>Loading...</p>
}
else if (tasks.Count == 0)
{
    <div class="alert alert-info">
        Task олдсонгүй.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Employee</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Start Date</th>
                    <th>Due Date</th>
                    <th>Completed Date</th>
                    <th>Overdue</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var task in tasks)
                {
                    <tr>
                        <td>@task.Id</td>

                        <td>@task.Title</td>

                        <td>@task.EmployeeName</td>

                        <td>@task.PriorityName</td>

                        <td>
                            @task.StatusName
                        </td>

                        <td>
                            @task.StartDate.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @task.DueDate.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @if (task.CompletedDate.HasValue)
                            {
                                @task.CompletedDate.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @(task.IsOverdue ? "Yes" : "No")
                        </td>

                        <td>
                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => StartEdit(task.Id)">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => OpenDeleteModal(task.Id, task.Title)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}


@code {
    private List<TaskListItem>? tasks;

    private List<Employee>? employees;

    private string? message;

    private string? editMessage;

    private string? statusMessage;

    private TaskItem? editTask;

    private TaskManagement.Models.TaskStatus? originalEditStatus;

    private bool showCreateModal;

    private bool showDeleteModal;

    private int? deleteTaskId;

    private string? deleteTaskTitle;


    // FILTER
    private int? filterEmployeeId;

    private int? filterStatus;

    private int? filterPriority;

    private string? searchText;


    // NEW TASK
    private TaskItem newTask = CreateEmptyTask();


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        tasks =
            await TaskService.GetTaskListAsync(
                filterEmployeeId,
                filterStatus,
                filterPriority,
                searchText
            );

        employees =
            await EmployeeService.GetEmployeesAsync();
    }


    // FILTER
    private async Task ApplyFilters()
    {
        await LoadData();
    }


    private async Task ClearFilters()
    {
        filterEmployeeId = null;

        filterStatus = null;

        filterPriority = null;

        searchText = null;

        await LoadData();
    }


    // CREATE
    private void OpenCreateModal()
    {
        message = null;

        editTask = null;

        CloseDeleteModal();

        newTask = CreateEmptyTask();

        showCreateModal = true;
    }


    private void CloseCreateModal()
    {
        showCreateModal = false;

        message = null;
    }


    private async Task CreateTask()
    {
        message = null;

        try
        {
            if (newTask.EmployeeId == 0)
            {
                message = "Employee сонгоно уу.";
                return;
            }

            await TaskService.CreateTaskAsync(newTask);

            showCreateModal = false;

            newTask = CreateEmptyTask();

            await LoadData();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }


    private static TaskItem CreateEmptyTask()
    {
        return new TaskItem
        {
            Priority = TaskPriority.Normal,

            Status =
                TaskManagement.Models.TaskStatus.New,

            StartDate = DateTime.Today,

            DueDate = DateTime.Today
        };
    }


    // EDIT
    private async Task StartEdit(int id)
    {
        editMessage = null;

        showCreateModal = false;

        CloseDeleteModal();

        editTask =
            await TaskService.GetTaskByIdAsync(id);

        if (editTask != null)
        {
            originalEditStatus = editTask.Status;
        }
    }


    private async Task SaveTask()
    {
        if (editTask == null)
        {
            return;
        }

        editMessage = null;

        try
        {
            await TaskService.UpdateTaskAsync(editTask);

            if (originalEditStatus.HasValue &&
                originalEditStatus.Value != editTask.Status)
            {
                await TaskService.ChangeTaskStatusAsync(
                    editTask.Id,
                    editTask.Status
                );
            }

            editTask = null;

            originalEditStatus = null;

            await LoadData();
        }
        catch (Exception ex)
        {
            editMessage = ex.Message;
        }
    }


    private void CancelEdit()
    {
        editTask = null;

        originalEditStatus = null;

        editMessage = null;
    }


    // DELETE
    private void OpenDeleteModal(
        int id,
        string title)
    {
        showCreateModal = false;

        editTask = null;

        deleteTaskId = id;

        deleteTaskTitle = title;

        showDeleteModal = true;
    }


    private void CloseDeleteModal()
    {
        showDeleteModal = false;

        deleteTaskId = null;

        deleteTaskTitle = null;
    }


    private async Task ConfirmDeleteTask()
    {
        if (!deleteTaskId.HasValue)
        {
            return;
        }

        await TaskService.DeleteTaskAsync(
            deleteTaskId.Value
        );

        CloseDeleteModal();

        await LoadData();
    }
}
