@page "/employees"
@rendermode InteractiveServer

@using TaskManagement.Models
@using TaskManagement.Services

@inject EmployeeService EmployeeService

<h1>Employees</h1>

<div class="card p-3 mb-4">
    <div class="card p-3 mb-4">
        <h4>Search Employee</h4>

        <form @onsubmit="SearchEmployees"
              @onsubmit:preventDefault>

            <div class="input-group">
                <input class="form-control"
                       placeholder="Name эсвэл Department..."
                       @bind="searchText" />

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="ClearSearch">
                    Clear
                </button>
            </div>

        </form>
    </div>
</div>
<div class="card p-3 mb-4">
    <h4>Add Employee</h4>

    <div class="mb-2">
        <label>Name</label>
        <input class="form-control"
               @bind="newEmployee.Name" />
    </div>

    <div class="mb-2">
        <label>Department</label>
        <input class="form-control"
               @bind="newEmployee.Department" />
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input"
               type="checkbox"
               @bind="newEmployee.IsActive" />

        <label class="form-check-label">
            Active
        </label>
    </div>

    <button class="btn btn-primary"
            @onclick="AddEmployee">
        Add Employee
    </button>
</div>

@if (editEmployee != null)
{
    <div class="card p-3 mb-4">
        <h4>Edit Employee</h4>

        <div class="mb-2">
            <label>Name</label>
            <input class="form-control"
                   @bind="editEmployee.Name" />
        </div>

        <div class="mb-2">
            <label>Department</label>
            <input class="form-control"
                   @bind="editEmployee.Department" />
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input"
                   type="checkbox"
                   @bind="editEmployee.IsActive" />

            <label class="form-check-label">
                Active
            </label>
        </div>

        <button class="btn btn-success me-2"
                @onclick="UpdateEmployee">
            Save
        </button>

        <button class="btn btn-secondary"
                @onclick="CancelEdit">
            Cancel
        </button>
    </div>
}

@if (employees == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Department</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in employees)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                    <td>@employee.Department</td>
                    <td>
                        @(employee.IsActive
                            ? "Active"
                            : "Inactive")
                    </td>

                    <td>
                        <button class="btn btn-warning btn-sm"
                                @onclick="() => StartEdit(employee)">
                            Edit
                        </button>

                        @if (employee.IsActive)
                        {
                            <button class="btn btn-danger btn-sm ms-2"
                                    @onclick="() => DeactivateEmployee(employee.Id)">
                                Deactivate
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private List<Employee>? employees;
    private string? searchText;
    private Employee newEmployee = new()
    {
        IsActive = true
    };

    private Employee? editEmployee;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        employees =
            await EmployeeService.GetEmployeesAsync(searchText);
    }

    private async Task AddEmployee()
    {
        await EmployeeService.AddEmployeeAsync(
            newEmployee
        );

        newEmployee = new Employee
        {
            IsActive = true
        };

        await LoadEmployees();
    }

    private void StartEdit(Employee employee)
    {
        editEmployee = new Employee
        {
            Id = employee.Id,
            Name = employee.Name,
            Department = employee.Department,
            IsActive = employee.IsActive
        };
    }

    private async Task UpdateEmployee()
    {
        if (editEmployee == null)
            return;

        await EmployeeService.UpdateEmployeeAsync(
            editEmployee
        );

        editEmployee = null;

        await LoadEmployees();
    }

    private void CancelEdit()
    {
        editEmployee = null;
    }

    private async Task DeactivateEmployee(int id)
    {
        await EmployeeService.DeactivateEmployeeAsync(id);

        await LoadEmployees();
    }
    private async Task SearchEmployees()
    {
        await LoadEmployees();
    }

    private async Task ClearSearch()
    {
        searchText = null;

        await LoadEmployees();
    }
}